#!/usr/bin/env sh
# SketchyBar configuration, Catppuccin Mocha. See docs/sketchybar.md.

PLUGINS="$CONFIG_DIR/plugins"

# Catppuccin Mocha colors (0xAARRGGBB).
BASE=0xff1e1e2e
SURFACE0=0xff313244
TEXT=0xffcdd6f4
MAUVE=0xffcba6f7

FONT="JetBrainsMono Nerd Font"

sketchybar --bar height=32 \
                 position=top \
                 color=$BASE \
                 padding_left=8 \
                 padding_right=8

sketchybar --default icon.font="$FONT:Bold:14.0" \
                     icon.color=$TEXT \
                     label.font="$FONT:Bold:13.0" \
                     label.color=$TEXT \
                     padding_left=4 \
                     padding_right=4 \
                     icon.padding_left=4 \
                     icon.padding_right=4 \
                     label.padding_left=4 \
                     label.padding_right=4

sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.color=$MAUVE \
                           script="$PLUGINS/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add item clock right \
           --set clock update_freq=30 \
                       icon.drawing=off \
                       script="$PLUGINS/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGINS/volume.sh" \
           --subscribe volume volume_change \
           --add item wifi right \
           --set wifi script="$PLUGINS/wifi.sh" \
                      click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" \
           --subscribe wifi wifi_change system_woke \
           --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGINS/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add bracket status clock volume wifi battery \
           --set status background.color=$SURFACE0 \
                        background.corner_radius=6 \
                        background.height=24

sketchybar --update
