#!/usr/bin/env sh
# SketchyBar configuration, Catppuccin Mocha. See docs/yabai.md.

PLUGINS="$CONFIG_DIR/plugins"

# Catppuccin Mocha colors (0xAARRGGBB).
BASE=0xff1e1e2e
SURFACE0=0xff313244
TEXT=0xffcdd6f4
MAUVE=0xffcba6f7

FONT="JetBrainsMono Nerd Font"

# The height must match `external_bar` in yabairc.
sketchybar --bar height=32 \
                 position=top \
                 color=$BASE \
                 padding_left=8 \
                 padding_right=8

sketchybar --default icon.font="$FONT:Bold:14.0" \
                     icon.color=$TEXT \
                     label.font="$FONT:Bold:13.0" \
                     label.color=$TEXT \
                     padding_left=4 \
                     padding_right=4 \
                     icon.padding_left=4 \
                     icon.padding_right=4 \
                     label.padding_left=4 \
                     label.padding_right=4

# Mission Control Spaces 1-9; clicking an item focuses its Space.
for sid in 1 2 3 4 5 6 7 8 9; do
  sketchybar --add space space.$sid left \
             --set space.$sid space=$sid \
                              icon=$sid \
                              icon.highlight_color=$BASE \
                              background.color=$MAUVE \
                              background.corner_radius=6 \
                              background.height=22 \
                              background.drawing=off \
                              script="$PLUGINS/space.sh" \
                              click_script="yabai -m space --focus $sid"
done

sketchybar --add item front_app left \
           --set front_app icon.drawing=off \
                           label.color=$MAUVE \
                           script="$PLUGINS/front_app.sh" \
           --subscribe front_app front_app_switched

sketchybar --add item clock right \
           --set clock update_freq=30 \
                       icon.drawing=off \
                       script="$PLUGINS/clock.sh" \
           --add item volume right \
           --set volume script="$PLUGINS/volume.sh" \
           --subscribe volume volume_change \
           --add item battery right \
           --set battery update_freq=120 \
                         script="$PLUGINS/battery.sh" \
           --subscribe battery system_woke power_source_change

sketchybar --add bracket status clock volume battery \
           --set status background.color=$SURFACE0 \
                        background.corner_radius=6 \
                        background.height=24

sketchybar --update
