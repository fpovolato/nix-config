# skhd.zig hotkeys for yabai. See docs/yabai.md.
# Commands use the full yabai path: the launchd service has no Homebrew PATH.

# skhd does not intercept any key while these apps are focused.
# DaVinci Resolve uses Option for most of its own shortcuts.
.blacklist [
    "davinci resolve"
    "resolve"
]

# Focus a window.
alt - left  : /opt/homebrew/bin/yabai -m window --focus west
alt - down  : /opt/homebrew/bin/yabai -m window --focus south
alt - up    : /opt/homebrew/bin/yabai -m window --focus north
alt - right : /opt/homebrew/bin/yabai -m window --focus east
alt - tab   : /opt/homebrew/bin/yabai -m window --focus recent

# Swap the focused window with its neighbor.
shift + alt - left  : /opt/homebrew/bin/yabai -m window --swap west
shift + alt - down  : /opt/homebrew/bin/yabai -m window --swap south
shift + alt - up    : /opt/homebrew/bin/yabai -m window --swap north
shift + alt - right : /opt/homebrew/bin/yabai -m window --swap east

# Focus Space 1-9 (needs the scripting addition).
alt - 1 : /opt/homebrew/bin/yabai -m space --focus 1
alt - 2 : /opt/homebrew/bin/yabai -m space --focus 2
alt - 3 : /opt/homebrew/bin/yabai -m space --focus 3
alt - 4 : /opt/homebrew/bin/yabai -m space --focus 4
alt - 5 : /opt/homebrew/bin/yabai -m space --focus 5
alt - 6 : /opt/homebrew/bin/yabai -m space --focus 6
alt - 7 : /opt/homebrew/bin/yabai -m space --focus 7
alt - 8 : /opt/homebrew/bin/yabai -m space --focus 8
alt - 9 : /opt/homebrew/bin/yabai -m space --focus 9
ctrl + alt - tab : /opt/homebrew/bin/yabai -m space --focus recent

# Move the focused window to Space 1-9.
shift + alt - 1 : /opt/homebrew/bin/yabai -m window --space 1
shift + alt - 2 : /opt/homebrew/bin/yabai -m window --space 2
shift + alt - 3 : /opt/homebrew/bin/yabai -m window --space 3
shift + alt - 4 : /opt/homebrew/bin/yabai -m window --space 4
shift + alt - 5 : /opt/homebrew/bin/yabai -m window --space 5
shift + alt - 6 : /opt/homebrew/bin/yabai -m window --space 6
shift + alt - 7 : /opt/homebrew/bin/yabai -m window --space 7
shift + alt - 8 : /opt/homebrew/bin/yabai -m window --space 8
shift + alt - 9 : /opt/homebrew/bin/yabai -m window --space 9

# Layout.
alt - return    : /opt/homebrew/bin/yabai -m window --toggle zoom-fullscreen
shift + alt - f : /opt/homebrew/bin/yabai -m window --toggle float --grid 6:6:1:1:4:4
alt - r         : /opt/homebrew/bin/yabai -m space --rotate 90
alt - 0         : /opt/homebrew/bin/yabai -m space --balance

# Focus the next display.
ctrl + cmd - tab : /opt/homebrew/bin/yabai -m display --focus next || /opt/homebrew/bin/yabai -m display --focus first
