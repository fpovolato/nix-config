{ lib, pkgs, ... }:

# Quickshell draws the status bar from the QML files in ./quickshell,
# installed as ~/.config/quickshell/bar. It runs as a user service started
# with the Hyprland session.
let
  # Network throughput scripts from egoist/omarchy-network-throughput (MIT):
  # interface rates from /sys/class/net and per-process TCP rates from ss.
  # The bar's Network widget runs them; their QML is not used.
  networkThroughput = pkgs.fetchFromGitHub {
    owner = "egoist";
    repo = "omarchy-network-throughput";
    rev = "01bb389eb3751426957dbdad3e2acfc2de022ad2";
    hash = "sha256-hrUS3oHlY4KBy8kcKkMcKieWX7AXEm3KKQeH5xV6wNY=";
  };

  networkScripts = pkgs.runCommand "network-throughput-scripts" {
    nativeBuildInputs = [ pkgs.makeWrapper ];
    buildInputs = [ pkgs.bash ];
  } ''
    for script in network-throughput process-throughput; do
      install -Dm755 ${networkThroughput}/scripts/$script $out/bin/$script
      patchShebangs $out/bin/$script
      # The scripts need GNU awk (three-argument match) and iproute2's ss.
      wrapProgram $out/bin/$script --set PATH ${lib.makeBinPath (with pkgs; [
        coreutils
        gawk
        iproute2
        jq
      ])}
    done
    install -Dm644 ${networkThroughput}/LICENSE $out/share/licenses/network-throughput/LICENSE
  '';

  # ./quickshell plus a Scripts singleton holding the scripts' store paths.
  barConfig = pkgs.runCommand "quickshell-bar" { } ''
    cp -r ${./quickshell} $out
    chmod u+w $out
    cat > $out/Scripts.qml <<'EOF'
    // Generated by home/xhan/linux/quickshell.nix.
    pragma Singleton

    import Quickshell

    Singleton {
        readonly property string networkThroughput: "${networkScripts}/bin/network-throughput"
        readonly property string processThroughput: "${networkScripts}/bin/process-throughput"
    }
    EOF
  '';
in
{
  programs.quickshell = {
    enable = true;

    configs.bar = barConfig;
    activeConfig = "bar";

    systemd = {
      enable = true;
      target = "hyprland-session.target";
    };
  };
}
